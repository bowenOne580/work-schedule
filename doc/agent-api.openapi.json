                  ]
                }
              }
            }
          },
          "400": {
            "description": "结构化错误，包含 error.code、message、details。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
