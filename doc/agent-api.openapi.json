                    "false"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Category"
                    }
                  }
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "schema": {
